			.caja h3 { font-size: 19px; margin: 0; color: var(--color-text); }
			.caja p { font-size: 15px; line-height: 1.5; color: #4a443c; margin: 0; }

			/* ═══ Franja de cierre ══════════════════════════════════════════ */
			.franja {
				background: var(--color-surface);
				border-radius: var(--radius-lg);
				padding: var(--space-8) calc(var(--space-8) * 1.5);
				display: flex; align-items: center; justify-content: space-between;
				gap: var(--space-8); flex-wrap: wrap;
			}
			.franja h2 { font-size: clamp(24px, 2.4vw, 30px); margin: 0 0 var(--space-2); }
			.franja p { font-size: 16px; line-height: 1.55; color: #4a443c; max-width: 58ch; }
			.escudo { flex: none; }

			/* ═══ Dos columnas ══════════════════════════════════════════════
			   `angosta` limita el texto a 68ch porque un renglón más largo se
			   lee mal. En un envase de 1264px eso dejaba media sección en
			   blanco, y se notaba. La solución no es ensanchar el texto
			   —empeoraría la lectura— sino ocupar el hueco con algo que valga
			   la pena mirar. Apilado hasta 900px: en un teléfono dos columnas
			   de 180px no son columnas. */
			.duo { display: grid; gap: var(--space-6); align-items: start; }
			@media (min-width: 900px) {
				.duo {
					grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
					gap: calc(var(--space-8) * 1.2);
				}
			}

			/* ═══ Demostración de la estimación ═════════════════════════════
			   Replica el panel real de la aplicación: violeta y borde
			   punteado, FUERA de la escala cromática de NEWS2, donde el rojo,
			   el ámbar y el verde están reservados a los niveles de riesgo. El
			   punteado es la señal que no depende del color. */
			.predict-demo {
				border: 1px dashed #5b3d9e;
				background: #f0ebfa;
				border-radius: var(--radius-md);
				padding: var(--space-6);
				display: flex; flex-direction: column; gap: var(--space-3);
			}
			.predict-demo-cab { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
			.predict-demo-cab strong { font-size: 18px; color: var(--color-text); }
			.predict-pill {
				border: 1px dashed #5b3d9e; color: #5b3d9e;
				border-radius: var(--radius-sm); padding: 3px 10px;
				font-size: 12px; font-weight: 600;
			}
			.predict-demo-razon { font-size: 15px; line-height: 1.5; margin: 0; }
			.predict-demo-lista { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
			.predict-demo-lista li {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto 96px 52px;
				align-items: center; gap: var(--space-2);
				font-size: 13px;
			}
			.predict-demo-val { font-variant-numeric: tabular-nums; font-weight: 600; }
			.predict-barra { height: 6px; border-radius: 3px; background: #5b3d9e; }
			/* Lo que ALEJA de la alerta va hueco: dos direcciones opuestas no
			   pueden distinguirse sólo por color. Misma regla que en la app. */
			.predict-barra.hueca { background: transparent; border: 1px solid #5b3d9e; }
			.predict-demo-dir { font-size: 12px; color: #5f5a56; text-align: right; }
			.predict-demo-pie { font-size: 12px; color: #5f5a56; margin: 0; line-height: 1.5; }

			/* ═══ Ficha de cohortes ═════════════════════════════════════════ */
			.ficha {
				background: var(--color-surface);
				border-radius: var(--radius-md);
				padding: var(--space-6);
			}
			.ficha h3 { margin: 0 0 var(--space-4); font-size: 18px; }
			.ficha dl { margin: 0; display: flex; flex-direction: column; gap: var(--space-4); }
			.ficha dt { font-weight: 700; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
			.ficha dd { margin: 2px 0 0; font-size: 14px; line-height: 1.5; color: #4a443c; }
			.ficha-lic {
				font-size: 11px; font-weight: 600; letter-spacing: 0.04em;
				border: 1px solid var(--color-accent-400); color: var(--color-accent-700);
				border-radius: var(--radius-sm); padding: 2px 8px;
			}
			.ficha-uso { color: var(--color-accent-700); font-weight: 600; }
			.ficha-nota { margin: var(--space-4) 0 0; font-size: 13px; line-height: 1.55; color: #5f5a56; }

			/* ═══ Texto largo ═══════════════════════════════════════════════ */
			.angosta h2 { margin-block-end: var(--space-4); }
			.angosta p { margin-block-end: var(--space-3); line-height: 1.6; }
			.pila { display: flex; flex-wrap: wrap; gap: var(--space-2); }

			.cita {
				margin: var(--space-3) 0;
				padding: var(--space-3);
				/* El acento como BORDE, no como texto: 3.03:1 no alcanza para leer. */
				border-inline-start: 3px solid var(--color-accent);
				background: var(--color-surface);
				border-radius: var(--radius-md);
			}

			.aviso {
				padding: var(--space-6);
				border: 2px solid var(--color-accent-700);
				border-radius: var(--radius-md);
				background: var(--color-accent-100);
			}
			.aviso h2 { margin-block-start: 0; font-size: 25px; }
			.aviso p { margin: 0; }

			.pie {
				padding-block: var(--space-6) var(--space-8);
				border-block-start: 1px solid var(--color-divider);
				font-size: 14px;
			}

			/* ═══ Ancho ═════════════════════════════════════════════════════
			   1024px es el MISMO umbral que --breakpoint-ancho de la app: es
			   el ancho de una tablet acostada. Recién ahí la sala se ve como
			   tabla; debajo es lista, igual que en la aplicación real. */
			@media (min-width: 1024px) {
				.fila {
					grid-template-columns: 92px 1fr 96px 74px 148px;
					gap: 0;
				}
				/* La envoltura desaparece como caja y sus dos hijos pasan a ser
				   celdas de la grilla: una sola marcación sirve para los dos
				   formatos, sin duplicar el contenido ni ocultar nada. */
				.info { display: contents; }
				.toma { font-size: 13px; }
				.fila-titulos {
					display: grid;
					font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
					color: #5a636f; font-weight: 400;
					padding-block: var(--space-3) var(--space-2);
					border-block-end: 2px solid #7b8798;
				}
				.der { text-align: right; }
				.celda-nivel { text-align: right; }
				.chip { font-size: 13px; padding: 4px 11px; }
				.glifo { width: 11px; height: 11px; }
				.cajas { grid-template-columns: repeat(3, minmax(0, 1fr)); }
			}

			@media (max-width: 1023px) {
				.escudo { width: 44px; height: 44px; }
			}

			/* Por debajo de 360px dos columnas dejan la tarjeta en ~140px y el
			   título parte en cuatro renglones. Una sola columna. */
			@media (max-width: 359px) {
				.cajas { grid-template-columns: 1fr; }
			}
		</style>

		<script>
			// Publica el avance del scroll por la intro (ver el bloque Intro del
			// CSS). Una sola escritura por cuadro: el scroll solo pide un rAF si
			// no hay uno pendiente. Con "reducir movimiento" no se engancha nada
			// y la intro queda como portada quieta de una pantalla.
			//
			// Reparto del recorrido: los cinco símbolos se encienden entre 0,06
			// y 0,66, uno detrás del otro y apenas solapados; de 0,66 a 1 la Z
			// vuela al sello de la barra y la capa crema se desvanece.
			const PICOS = [0.12, 0.24, 0.36, 0.48, 0.6]
			const ANCHO_PICO = 0.085
			const INICIO_CIERRE = 0.66
			const acotar = (x: number) => Math.min(1, Math.max(0, x))
			// Sube y baja suave (seno), no en triángulo: la luz no "rebota".
			const luz = (p: number, pico: number) => {
				const t = acotar(1 - Math.abs(p - pico) / ANCHO_PICO)
				return Math.sin((t * Math.PI) / 2) ** 2
			}
			const suave = (t: number) => t * t * (3 - 2 * t)
			const intro = document.querySelector<HTMLElement>('[data-intro]')
			const reducir = window.matchMedia('(prefers-reduced-motion: reduce)')

			// ?animar fuerza la animación aunque el sistema pida reducir el
			// movimiento. Es para presentar desde una máquina ajena; el sitio
			// publicado sin el parámetro sigue respetando a cada visitante.
			const forzar = new URLSearchParams(window.location.search).has('animar')

			const escenario = document.querySelector<HTMLElement>('.escenario')
			const cola = document.querySelector<HTMLElement>('.escenario-cola')
			const marco = document.querySelector<HTMLElement>('.intro-z-marco')
			const sello = document.querySelector<HTMLElement>('.marca-sello img')

			// En pantallas táctiles la intro avanza por pasos, con un botón: el
			// scroll por inercia del teléfono se pasaba de largo y dejaba ver la
			// landing con la Z a mitad de camino. Con mouse sigue siendo el scroll.
			// ?pasos lo fuerza con mouse: para probarlo en la PC y para presentar
			// desde un proyector manejando la intro con clics.
			const tactil =
				window.matchMedia('(hover: none) and (pointer: coarse)').matches ||
				new URLSearchParams(window.location.search).has('pasos')
			const seguir = document.querySelector<HTMLButtonElement>('.intro-seguir')

			if (intro && escenario && cola && marco && sello && (forzar || !reducir.matches)) {
				intro.classList.add('intro-viva')
				document.body.classList.add('con-intro')
				if (forzar) intro.classList.add('intro-forzada')

				// El avance lo calcula cada modo; esto solo lo dibuja.
				const pintarEn = (p: number) => {
					// El vuelo: del centro de la Z grande al centro del sello. La
					// escena es fija en (0,0), así que offsetLeft/Top ya son
					// coordenadas de pantalla, y no incluyen la transformación.
					const destino = sello.getBoundingClientRect()
					const dx = destino.left + destino.width / 2 - (marco.offsetLeft + marco.offsetWidth / 2)
					const dy = destino.top + destino.height / 2 - (marco.offsetTop + marco.offsetHeight / 2)

					const cierre = acotar((p - INICIO_CIERRE) / (1 - INICIO_CIERRE))
					const s = intro.style
					s.setProperty('--p', p.toFixed(4))
					// Escalonado: primero vuela la Z (0 → 0,75 del cierre) y recién
					// después se aclara la capa (0,4 → 1). Al revés, la Z todavía
					// grande quedaba encima del titular de la landing.
					s.setProperty('--q', suave(acotar(cierre / 0.75)).toFixed(4))
					s.setProperty('--f', suave(acotar((cierre - 0.4) / 0.6)).toFixed(4))
					s.setProperty('--dx', `${dx.toFixed(1)}px`)
					s.setProperty('--dy', `${dy.toFixed(1)}px`)
					s.setProperty('--s', (destino.height / marco.offsetHeight).toFixed(4))
					PICOS.forEach((pico, i) => s.setProperty(`--g${i}`, luz(p, pico).toFixed(3)))

					intro.classList.toggle('intro-fin', p >= 1)
					document.body.classList.toggle('intro-en-curso', p < 1)
				}

				if (tactil && seguir) {
					// ── Por pasos ──────────────────────────────────────────────
					// Cada toque lleva el avance al pico del símbolo siguiente, y el
					// último, de la Tierra encendida al final del vuelo. Es el MISMO
					// avance que publica el scroll, así que el dibujo no cambia: solo
					// quién decide cuánto avanzar.
					const PARADAS = [0, ...PICOS, 1]
					const texto = seguir.querySelector<HTMLElement>('.intro-seguir-texto')
					const raiz = document.documentElement
					let parada = 0
					let actual = 0

					document.body.classList.add('intro-pasos')
					raiz.classList.add('intro-trabada')
					seguir.hidden = false

					// iOS ignora el overflow hidden del body para el arrastre: sin
					// esto, un deslizamiento todavía movía la página por debajo.
					const sinArrastre = (e: TouchEvent) => e.preventDefault()
					window.addEventListener('touchmove', sinArrastre, { passive: false })

					const etiquetar = () => {
						// El último toque es el que entra: el botón lo dice.
						if (texto) texto.textContent = parada === PARADAS.length - 2 ? 'Entrar' : 'Continuar'
					}

					const ir = (destino: number, ms: number, alTerminar?: () => void) => {
						const desde = actual
						const t0 = performance.now()
						const cuadro = (ahora: number) => {
							const t = acotar((ahora - t0) / ms)
							actual = desde + (destino - desde) * suave(t)
							pintarEn(actual)
							if (t < 1) requestAnimationFrame(cuadro)
							else alTerminar?.()
						}
						requestAnimationFrame(cuadro)
					}

					seguir.addEventListener('click', () => {
						if (seguir.disabled || parada >= PARADAS.length - 1) return
						parada += 1
						seguir.disabled = true
						const final = parada === PARADAS.length - 1
						// El vuelo dura más que un pulso: es el cierre, y apurado la Z
						// llegaba al sello sin que se entendiera de dónde venía.
						ir(PARADAS[parada], final ? 1600 : 900, () => {
							if (final) {
								raiz.classList.remove('intro-trabada')
								window.removeEventListener('touchmove', sinArrastre)
								seguir.hidden = true
							} else {
								seguir.disabled = false
								etiquetar()
							}
						})
					})

					window.addEventListener('resize', () => pintarEn(actual))
					etiquetar()
					pintarEn(0)
				} else {
					// ── Con el scroll ──────────────────────────────────────────
					let pendiente = false
					const pintar = () => {
						pendiente = false
						const recorrido = cola.offsetHeight
						const hecho = window.scrollY - escenario.offsetTop
						pintarEn(acotar(recorrido > 0 ? hecho / recorrido : 1))
					}
					const pedir = () => {
						if (!pendiente) {
							pendiente = true
							requestAnimationFrame(pintar)
						}
					}

					window.addEventListener('scroll', pedir, { passive: true })
					window.addEventListener('resize', pedir)
					pintar()
				}
			}
		</script>
	</body>
</html>
