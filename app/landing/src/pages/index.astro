			}
			.marca {
				display: inline-flex; align-items: center; gap: 10px;
				font-family: var(--font-heading); font-size: 22px;
			}
			/* La Z es marrón: sobre la terracota se perdería. Va en un sello
			   crema, que es la variante clara del ícono de la lámina de marca. */
			.marca-sello {
				display: grid; place-items: center;
				width: 38px; height: 38px; border-radius: 11px;
				background: var(--color-bg);
			}
			.marca-sello img { width: auto; height: 28px; }

			/* ═══ Intro ═════════════════════════════════════════════════════
			   Sin JS o con "reducir movimiento": una portada quieta de una
			   pantalla, y el sitio sigue debajo.

			   Con JS (.intro-viva, y .con-intro en el body) la intro es una
			   CAPA fija encima del sitio. El recorrido de scroll lo da
			   .escenario-cola (200vh), y mientras se recorre .pagina queda
			   sticky arriba: debajo de la capa ya está la landing.
			   El script publica, todas de 0 a 1:
			   --p       el avance; se van el nombre y la pista
			   --g0..4   la luz de cada símbolo, que sube y vuelve a la piedra:
			             Caminos → Corazón → Conexión → Equilibrio → Tierra
			   --q       el vuelo: la Z viaja y se achica hasta el sello de la
			             barra de navegación (--dx, --dy, --s en píxeles/escala)
			   --f       la capa crema se desvanece y deja ver la landing */
			.intro {
				--p: 0; --q: 0; --f: 0;
				--dx: 0px; --dy: 0px; --s: 1;
				--g0: 0; --g1: 0; --g2: 0; --g3: 0; --g4: 0;
				height: 100dvh; background: var(--color-bg);
			}
			.intro.intro-viva { height: 0; background: none; }
			.con-intro .pagina { position: sticky; top: 0; }
			.con-intro .escenario-cola { height: 200vh; }
			.intro-viva .intro-escena {
				position: fixed; inset: 0; z-index: 20;
				height: auto;
				/* No tapa clics: cuando la capa se aclara, la barra de abajo
				   ya se puede usar. */
				pointer-events: none;
				isolation: isolate;
			}
			.intro-viva .intro-escena::before {
				content: ""; position: absolute; inset: 0; z-index: -1;
				background: var(--color-bg);
				opacity: calc(1 - var(--f));
			}
			/* Terminado el recorrido la capa se va del todo, y la Z del sello
			   (que estuvo oculta para no verse doble) toma la posta. */
			.intro-viva.intro-fin .intro-escena { visibility: hidden; }
			.intro-en-curso .marca-sello img { opacity: 0; }
			/* Arena de la paleta, un paso más profunda que --color-accent-2
			   para que el halo se lea sobre el crema. Nunca rojo ni ámbar:
			   esos colores son niveles de riesgo. */
			.z-halo { fill: #dcbd85; stroke: #dcbd85; stroke-width: 14px; stroke-linejoin: round; }
			.intro-escena {
				position: sticky; top: 0;
				height: 100dvh; overflow: hidden;
				display: flex; flex-direction: column;
				align-items: center; justify-content: center;
				gap: var(--space-6);
				padding-inline: var(--space-4);
			}
			.intro-z-marco {
				transform:
					translate(calc(var(--q) * var(--dx)), calc(var(--q) * var(--dy)))
					scale(calc(1 - var(--q) * (1 - var(--s))));
				will-change: transform;
			}
			.intro-z {
				display: block;
				/* El tercer tope es para el teléfono: con solo el alto, en 390px
				   de ancho la Z medía 394 y se salía de la pantalla. */
				height: min(50dvh, 460px, calc(78vw * 500 / 467)); width: auto;
				filter: drop-shadow(0 18px 28px rgb(62 46 35 / 0.18));
			}
			.intro-pie { display: grid; place-items: center; }
			.intro-pie > * { grid-area: 1 / 1; }
			.intro-lema {
				margin: 0;
				display: flex; flex-direction: column; align-items: center; gap: var(--space-2);
				text-align: center;
				/* Con umbral: el lema recién aparece cuando su luz pasó 0,3 y
				   está entero desde 0,6. Así entre un símbolo y el siguiente
				   hay un instante sin texto, y no dos frases encimadas. */
				opacity: clamp(0, calc((var(--g) - 0.3) * 3.4), 1);
				transform: translateY(calc((1 - var(--g)) * 10px));
			}
			.lema-simbolo {
				font-size: clamp(11px, 1vw, 13px); font-weight: 600;
				letter-spacing: 0.16em; text-transform: uppercase;
				color: var(--color-accent-700);
			}
			.lema-texto {
				font-family: var(--font-heading);
				font-size: clamp(20px, 2.4vw, 30px); line-height: 1.2;
				max-width: 24ch; text-wrap: balance;
				color: var(--color-text);
			}
			.intro-texto {
				text-align: center;
				opacity: calc(1 - clamp(0, var(--p) / 0.08, 1));
				transform: translateY(calc(var(--p) * 60vh));
			}
			.intro-nombre {
				margin: 0;
				font-weight: 600; letter-spacing: 0.42em;
				/* el letter-spacing también se agrega después de la última
				   letra; esto lo compensa para que quede centrado */
				margin-inline-end: -0.42em;
				font-size: clamp(30px, 4.4vw, 48px);
				color: var(--color-accent-700);
			}
			.intro-bajada {
				margin: var(--space-2) 0 0;
				font-size: clamp(11px, 1.1vw, 14px);
				letter-spacing: 0.16em; text-transform: uppercase;
				color: var(--color-neutral-700);
			}
			.intro-pista {
				position: absolute; bottom: var(--space-6);
				font-size: 13px; color: var(--color-neutral-700);
				opacity: calc(1 - clamp(0, var(--p) / 0.04, 1));
			}
			.intro-pista-in { display: inline-flex; flex-direction: column; align-items: center; gap: 4px; }

			/* Modo por pasos (.intro-pasos en el body, pantallas táctiles). En el
			   teléfono el scroll por inercia se pasaba de largo: un deslizamiento
			   corto recorría media intro y dejaba ver la landing con la Z a mitad
			   de vuelo. Acá no hay recorrido de scroll: la página queda trabada
			   arriba y cada toque del botón avanza un pulso. */
			.intro-pasos .escenario-cola { height: 0; }
			html.intro-trabada, html.intro-trabada body { overflow: hidden; overscroll-behavior: none; }
			.intro-pasos .intro-pista { display: none; }
			.intro-seguir {
				position: absolute; bottom: max(var(--space-6), env(safe-area-inset-bottom));
				/* La capa no toma clics (ver .intro-escena); el botón sí. */
				pointer-events: auto;
				display: inline-flex; align-items: center; gap: var(--space-2);
				/* Se va con el vuelo de la Z, igual que se iba la pista. */
				opacity: calc(1 - var(--q));
			}
			.intro-seguir[hidden] { display: none; }
			.intro-seguir:disabled { cursor: default; }
			@media (prefers-reduced-motion: no-preference) {
				.intro-seguir { animation: asomar 0.8s ease-out 1.8s backwards; }
			}
			.intro-forzada .intro-seguir { animation: asomar 0.8s ease-out 1.8s backwards; }

			/* La entrada al cargar: la Z se "talla" (aparece desde el centro y
			   se enfoca) y después llegan el nombre y la pista. Solo corre una
			   vez y solo si el sistema no pide reducir el movimiento. */
			/* .intro-forzada la pone el script con ?animar en la URL: es para
			   la exposición, cuando la máquina que presenta tiene "reducir
			   movimiento" activado. Sin ese parámetro se respeta al visitante. */
			@media (prefers-reduced-motion: no-preference) {
				.intro-z { animation: tallar 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) backwards; }
				.intro-nombre, .intro-bajada { animation: asomar 0.9s ease-out backwards; }
				.intro-nombre { animation-delay: 0.9s; }
				.intro-bajada { animation-delay: 1.15s; }
				.intro-pista-in { animation: asomar 0.8s ease-out 1.8s backwards; }
				.intro-pista svg { animation: latir 2.2s ease-in-out 2.6s infinite; }
			}
			.intro-forzada .intro-z { animation: tallar 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) backwards; }
			.intro-forzada .intro-nombre, .intro-forzada .intro-bajada { animation: asomar 0.9s ease-out backwards; }
			.intro-forzada .intro-nombre { animation-delay: 0.9s; }
			.intro-forzada .intro-bajada { animation-delay: 1.15s; }
			.intro-forzada .intro-pista-in { animation: asomar 0.8s ease-out 1.8s backwards; }
			.intro-forzada .intro-pista svg { animation: latir 2.2s ease-in-out 2.6s infinite; }
			@keyframes tallar {
				from {
					opacity: 0; transform: scale(1.06); filter: blur(8px) drop-shadow(0 0 0 transparent);
					clip-path: circle(0% at 50% 50%);
				}
				to {
					opacity: 1; transform: none; filter: blur(0) drop-shadow(0 18px 28px rgb(62 46 35 / 0.18));
					clip-path: circle(75% at 50% 50%);
				}
			}
			@keyframes asomar {
				from { opacity: 0; translate: 0 10px; }
				to   { opacity: 1; translate: 0 0; }
			}
			@keyframes latir {
				0%, 100% { translate: 0 0; }
				50%      { translate: 0 5px; }
			}
