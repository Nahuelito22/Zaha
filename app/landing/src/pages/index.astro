---
import '../styles/global.css'
import DemoMotor from '../components/DemoMotor.astro'
import { ANCHO, ALTO, SIMBOLOS, CENTROS_ESPIRALES } from '../marca/z-simbolos'

// El orden en que se encienden los cinco símbolos de la Z en la intro. Los
// moldes salen de app/landing/scripts/vectorizar_z.py, que los genera en otro
// orden; acá se reordenan. Tierra va ÚLTIMA porque su molde es la Z entera
// (64.687 px contra 19.137 del siguiente): es el pulso que la ilumina toda, y
// cierra la secuencia antes del vuelo al sello.
const ORDEN = ['caminos', 'corazon', 'conexion', 'equilibrio', 'tierra'] as const
const simbolos = ORDEN.map((nombre) => [nombre, SIMBOLOS[nombre]] as const)
const zPng = '/marca/zaha-z.png'

// Lo que dice cada símbolo mientras se enciende: su nombre en la lámina
// de marca y qué hace Zaha que tenga que ver. Va por nombre y no por posición,
// para que cambiar ORDEN no deje un lema pegado al símbolo equivocado.
// Solo cosas que la app HACE; Equilibrio es objetivo, no resultado (la
// reducción de alertas todavía tiene un IC que cruza el cero).
const LEMAS: Record<(typeof ORDEN)[number], { simbolo: string; texto: string }> = {
	caminos: { simbolo: 'Caminos de la vida', texto: 'El historial de cada paciente, toma a toma.' },
	corazon: { simbolo: 'Corazón · Cuidado', texto: 'Hecho para enfermería, al pie de la cama.' },
	conexion: { simbolo: 'Conexión · Energía', texto: 'Sigue funcionando sin señal y sincroniza al volver.' },
	equilibrio: { simbolo: 'Equilibrio · Armonía', texto: 'Alertar a tiempo, sin saturar de alarmas.' },
	tierra: { simbolo: 'Tierra · Origen', texto: 'Cada puntaje muestra de dónde sale.' },
}
const lemas = ORDEN.map((nombre) => LEMAS[nombre])

// SCRUM-35. Dirección visual elegida con Nahuel sobre un lienzo de tres bocetos:
// bloque terracota lleno arriba, el tablero real montado encima, cuatro cajas y
// un cierre en franja de superficie.
//
// Dos reglas que gobiernan este archivo:
//
// 1. CONTRASTE. --color-accent (#c67139) da 3.03:1 sobre el fondo crema: sirve
//    de relleno y de borde, NUNCA de texto. Todo texto con color usa el paso
//    -700. Medido con design_system/auditoria_contraste.py.
//
// 2. EL TABLERO NO MIENTE. Debajo de 1024px la sala se muestra como LISTA, que
//    es lo que la app hace de verdad en ese ancho (--breakpoint-ancho). Una
//    tabla encogida en la landing prometería una pantalla que no existe.

const camas = [
  { cama: 'CM-07', paciente: 'Páez, Ramón Osvaldo',   toma: 'hace 14 d', score: 18, nivel: 'Alto',       clase: 'alto' },
  { cama: 'CM-01', paciente: 'Quiroga, Rosa Beatriz', toma: 'hace 2 d',  score: 16, nivel: 'Alto',       clase: 'alto' },
  { cama: 'CM-05', paciente: 'Ojeda, Nélida Carmen',  toma: 'hace 14 d', score: 6,  nivel: 'Medio',      clase: 'medio' },
  { cama: 'CM-03', paciente: 'Funes, Héctor Alfredo', toma: 'hace 14 d', score: 3,  nivel: 'Medio Bajo', clase: 'mediobajo' },
  { cama: 'CM-09', paciente: 'Vergara, Marta Susana', toma: 'hace 14 d', score: 0,  nivel: 'Bajo',       clase: 'bajo' },
]

const capacidades = [
  {
    titulo: 'NEWS2 automático',
    texto: 'Siete parámetros, un puntaje, sin cuentas a mano.',
    icono: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  },
  {
    titulo: 'Explica el número',
    texto: 'El aporte de cada parámetro, por separado.',
    icono: '<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/><circle cx="12" cy="12" r="2.5"/>',
  },
  {
    titulo: 'Sin señal',
    texto: 'Sigue tomando carga y sincroniza al volver.',
    icono: '<rect x="5" y="2" width="14" height="20" rx="2.5"/><path d="M11 18h2"/><path d="M3 3l18 18"/>',
  },
  {
    titulo: 'Antigüedad a la vista',
    texto: 'Cada fila dice hace cuánto se tomó ese dato.',
    icono: '<path d="M12 8v5l3 2"/><circle cx="12" cy="12" r="9"/>',
  },
  // Las dos del Sprint 5. La landing describía el producto de septiembre y se
  // había quedado sin la mitad que lo distingue.
  {
    titulo: 'Estimación del modelo',
    texto: 'Aparte de la escala, con qué parámetro pesó en cada caso.',
    icono: '<path d="M3 17l5-5 4 3 6-7"/><path d="M21 8h-3V5"/>',
  },
  {
    titulo: 'Un clic, y queda firmado',
    texto: 'Validar o posponer una alerta, con el acuse en la bitácora.',
    icono: '<path d="M20 6L9 17l-5-5"/>',
  },
]
---

<html lang="es-AR">
	<head>
		<meta charset="utf-8" />
		<!-- La Z sobre beige, la misma del ícono de la PWA. Los genera
		     scripts/generar_marca_web.py. -->
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#8c491a" />
		<link rel="canonical" href="https://zahasalud.com.ar/" />

		<!-- Vista previa al compartir el link (WhatsApp, LinkedIn, etc.). La
		     imagen va con URL absoluta: las redes no resuelven rutas relativas. -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:site_name" content="Zaha" />
		<meta property="og:url" content="https://zahasalud.com.ar/" />
		<meta property="og:title" content="Zaha — Soporte a la decisión clínica" />
		<meta property="og:description" content="NEWS2 y alertas tempranas de deterioro para enfermería de sala de internación. Proyecto académico." />
		<meta property="og:image" content="https://zahasalud.com.ar/og.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="La Z de Zaha tallada en piedra, junto al titular: El deterioro avisa antes de ser una urgencia." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Preload que se vuelve hoja al cargar: no bloquea el primer pintado
		     (Lighthouse medía ~820 ms en móvil). Mismo patrón que la app. -->
		<link
			rel="preload"
			as="style"
			href="https://fonts.googleapis.com/css2?family=Caprasimo:wght@400&family=Figtree:wght@400;600;700&display=swap"
			onload="this.onload=null;this.rel='stylesheet'"
		/>
		<noscript>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caprasimo:wght@400&family=Figtree:wght@400;600;700&display=swap" />
		</noscript>
		<!-- La Z es lo más grande de la primera pantalla (el LCP), pero vive
		     dentro de un <image> de SVG y el navegador la descubre tarde. -->
		<link rel="preload" as="image" href="/marca/zaha-z.png" fetchpriority="high" />
		<meta
			name="description"
			content="Zaha — soporte a la decisión clínica: NEWS2 y alertas tempranas de deterioro para enfermería de sala de internación. Proyecto académico."
		/>
		<title>Zaha — Soporte a la decisión clínica</title>
	</head>
	<body class="zaha-brand">
		<a class="saltar" href="#contenido">Saltar al contenido</a>

		<!-- ── Intro: la Z tallada ──────────────────────────────────────────
		     La mueve el SCROLL, no un temporizador: quien visita controla el
		     ritmo y nadie queda esperando que termine. El script de abajo
		     publica el avance en --p (0 a 1) y el CSS deriva todo de ahí.
		     Sin JS o con "reducir movimiento" queda una portada quieta de una
		     pantalla, y el resto del sitio sigue debajo igual que siempre. -->
		<section class="intro" aria-label="Zaha" data-intro>
			<div class="intro-escena">
				<div class="intro-z-marco">
					<!-- Lo que se VE es siempre el PNG, con su piedra. Los trazados
					     son moldes: recortan ese mismo PNG para encender cada
					     símbolo (más luz) y dibujar su halo detrás. Cada símbolo
					     lee su intensidad de --g0..--g4. -->
					<svg class="intro-z" viewBox={`0 0 ${ANCHO} ${ALTO}`} width={ANCHO} height={ALTO} aria-hidden="true">
						<defs>
							{/* Las espirales comparten la barra de la Z, que sigue de largo:
							    en vez de un corte recto, la luz se apaga en degradé desde
							    el centro de cada una. Transparente y no negro, para que un
							    degradé no tape al otro donde se cruzan. */}
							{CENTROS_ESPIRALES.map(([cx, cy], i) => (
								<radialGradient id={`z-suave-${i}`} gradientUnits="userSpaceOnUse" cx={cx} cy={cy} r="88">
									<stop offset="0.55" stop-color="#fff" />
									<stop offset="1" stop-color="#fff" stop-opacity="0" />
								</radialGradient>
							))}
							{simbolos.map(([nombre, d]) => (
								<mask id={`z-molde-${nombre}`} maskUnits="userSpaceOnUse" x="0" y="0" width={ANCHO} height={ALTO}>
									{nombre === 'caminos'
										? CENTROS_ESPIRALES.map((_, i) => <path d={d} fill-rule="evenodd" fill={`url(#z-suave-${i})`} />)
										: <path d={d} fill-rule="evenodd" fill="#fff" />}
								</mask>
							))}
							<filter id="z-halo" x="-30%" y="-30%" width="160%" height="160%">
								<feGaussianBlur stdDeviation="13" />
							</filter>
							<!-- Aclara hacia la arena, no satura: multiplicar solo el
							     rojo empujaba el marrón a naranja, que acá está vedado. -->
							<filter id="z-luz">
								<feComponentTransfer>
									<feFuncR type="linear" slope="1.25" intercept="0.2" />
									<feFuncG type="linear" slope="1.3" intercept="0.2" />
									<feFuncB type="linear" slope="1.3" intercept="0.16" />
								</feComponentTransfer>
							</filter>
						</defs>
						{simbolos.map(([nombre, d], i) => (
							<path class="z-halo" d={d} fill-rule="evenodd" filter="url(#z-halo)"
								mask={nombre === 'caminos' ? 'url(#z-molde-caminos)' : undefined}
								style={`opacity: var(--g${i})`} />
						))}
						<image href={zPng} width={ANCHO} height={ALTO} />
						{simbolos.map(([nombre], i) => (
							<image class="z-luz" href={zPng} width={ANCHO} height={ALTO}
								mask={`url(#z-molde-${nombre})`} filter="url(#z-luz)"
								style={`opacity: var(--g${i})`} />
						))}
					</svg>
				</div>
				<!-- El nombre y los cinco lemas ocupan la MISMA celda: el nombre
				     se va al empezar el scroll y cada lema aparece con la luz de
				     su símbolo (--g0..--g4). Son un adorno de la intro; lo mismo
				     está dicho en la landing, por eso van ocultos al lector. -->
				<div class="intro-pie">
					<div class="intro-texto">
						<p class="intro-nombre">ZAHA</p>
						<p class="intro-bajada">Salud ancestral · Inteligencia que cuida</p>
					</div>
					{lemas.map((l, i) => (
						<p class="intro-lema" aria-hidden="true" style={`--g: var(--g${i})`}>
							<span class="lema-simbolo">{l.simbolo}</span>
							<span class="lema-texto">{l.texto}</span>
						</p>
					))}
				</div>
				<!-- Dos cajas a propósito: la de afuera se apaga con el scroll y
				     la de adentro tiene la animación de entrada. En una sola, la
				     animación pisaba la opacidad del scroll mientras corría. -->
				<span class="intro-pista" aria-hidden="true">
					<span class="intro-pista-in">
						Deslizá para entrar
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
					</span>
				</span>
				<!-- En pantallas táctiles la intro no avanza con el scroll sino con
				     este botón, un pulso por toque (ver el script). Nace oculto: sin
				     JS no hay nada que avanzar. -->
				<button class="intro-seguir btn btn-primary btn-touch" type="button" hidden>
					<span class="intro-seguir-texto">Continuar</span>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
				</button>
			</div>
		</section>

		<!-- Con la intro viva, .pagina es sticky y .escenario-cola le agrega
		     recorrido vacío: mientras se scrollea esa cola, el navegador mismo
		     deja la landing quieta arriba, debajo de la capa de la intro. Con
		     CSS y no con JS a propósito: el scroll de Chrome corre en otro hilo
		     y fijarla desde un script la hacía temblar un cuadro. -->
		<div class="escenario">
		<div class="pagina">
		<!-- ── Bloque de marca: nav + promesa ───────────────────────────── -->
		<div class="bloque">
			<div class="env">
				<header class="barra">
					<span class="marca">
						<span class="marca-sello"><img src="/marca/zaha-z.png" alt="" width="467" height="500" /></span>
						Zaha
					</span>
					<nav aria-label="Secciones">
						<a href="#producto">Producto</a>
						<a href="#tecnologia">Tecnología</a>
						<a href="#datos">Datos</a>
						<a href="/manual">Manual</a>
						<a class="entrar" href="/app/">Entrar</a>
					</nav>
				</header>

				<div class="hero">
					<span class="kicker">Soporte a la decisión clínica</span>
					<h1>El deterioro avisa antes de ser una urgencia.</h1>
					<p class="entrada">
						Zaha calcula NEWS2 sobre los signos vitales cargados al pie de la cama y
						ordena la sala por riesgo, para que la intervención llegue mientras
						todavía sirve.
					</p>
					<div class="acciones">
						<a class="cta" href="/app/">Entrar a la aplicación</a>
						<a class="cta cta-fantasma" href="#producto">Ver cómo funciona</a>
					</div>
				</div>
			</div>
		</div>

		<main id="contenido">
			<!-- ── El producto, montado sobre el bloque ──────────────────── -->
			<section class="env" id="producto" aria-labelledby="h-producto">
				<h2 id="h-producto" class="oculto-visual">El tablero de triage</h2>

				<div class="tablero">
					<div class="tablero-cab">
						<span>Clínica Médica · 8 camas ocupadas · ordenadas por riesgo</span>
						<span class="vivo">
							<svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true"><circle cx="4" cy="4" r="4" fill="#1f7a44"/></svg>
							actualización en vivo
						</span>
					</div>

					<div class="fila fila-titulos" aria-hidden="true">
						<span>Cama</span><span>Paciente</span><span>Última toma</span>
						<span class="der">NEWS2</span><span class="der">Nivel</span>
					</div>

					{camas.map((c) => (
						<div class={`fila r-${c.clase}`}>
							<span class="celda-cama"><span class="barra-riesgo"></span>{c.cama}</span>
							{/* display:contents en ancho: `paciente` y `toma` se vuelven celdas de
							    la grilla. En angosto es una columna y quedan apiladas. */}
							<span class="info">
								<span class="paciente">{c.paciente}</span>
								<span class="toma">{c.toma}</span>
							</span>
							<span class="score">{c.score}</span>
							<span class="celda-nivel">
								<span class="chip">
									<span class="glifo"></span>{c.nivel}
								</span>
							</span>
						</div>
					))}
				</div>

				<p class="pie-figura">Pacientes ficticios, generados para desarrollo.</p>

				<!-- La demostración del motor, al lado del producto: acá es donde
				     quien visita está mirando qué hace Zaha. -->
				<div class="probar">
					<div>
						<h3>¿Cómo estima el modelo?</h3>
						<p>Cargá unos signos vitales y mirá la estimación con su explicación, parámetro por parámetro.</p>
					</div>
					<button type="button" class="btn btn-primary probar-boton" data-abrir-demo>
						Probá la estimación
					</button>
				</div>
			</section>

			<!-- ── Cuatro capacidades ────────────────────────────────────── -->
			<section class="env" aria-labelledby="h-capacidades">
				<h2 id="h-capacidades" class="oculto-visual">Qué hace</h2>
				<ul class="cajas" role="list">
					{capacidades.map((c) => (
						<li class="caja">
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icono} />
							<h3>{c.titulo}</h3>
							<p>{c.texto}</p>
						</li>
					))}
				</ul>
			</section>

			<!-- ── Cierre append-only ────────────────────────────────────── -->
			<section class="env" aria-labelledby="h-append">
				<div class="franja">
					<div>
						<h2 id="h-append">Un dato clínico no se borra</h2>
						<p>
							Una medición cargada no se sobrescribe nunca: se enmienda, y la
							original queda visible con su score y su alerta.
						</p>
					</div>
					<svg class="escudo" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#56633f" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M12 3l7 3v6c0 4-3 7-7 8-4-1-7-4-7-8V6z"/><path d="M9 12l2 2 4-4"/>
					</svg>
				</div>
			</section>

			<!-- ── Tecnología ───────────────────────────────────────────── -->
			<section class="env" id="tecnologia" aria-labelledby="h-tecnologia">
				<div class="duo">
				<div class="angosta">
				<h2 id="h-tecnologia">Cómo está construido</h2>
				<p class="pila">
					<span class="tag tag-neutral">React</span>
					<span class="tag tag-neutral">TypeScript</span>
					<span class="tag tag-neutral">Vite</span>
					<span class="tag tag-neutral">PWA</span>
					<span class="tag tag-neutral">Astro</span>
					<span class="tag tag-neutral">PostgreSQL</span>
					<span class="tag tag-neutral">Supabase</span>
					<span class="tag tag-neutral">Python</span>
				</p>
				<p>
					El motor de NEWS2 y las reglas de integridad viven en la base de datos, no
					en la pantalla: el puntaje de un paciente no depende del dispositivo desde
					el que se cargó la medición.
				</p>
				<p>
					<strong>El motor predictivo ya está integrado.</strong> Una regresión
					logística sobre los mismos siete parámetros corre como servicio aparte y
					devuelve, junto a la estimación, cuánto aportó cada parámetro. La
					aplicación la muestra separada de la escala, y si ese servicio no responde
					el puntaje NEWS2 sigue funcionando igual: nunca depende de él.
				</p>
				<p>
					<strong>Lo que todavía no está demostrado</strong> es que el modelo reduzca
					la cantidad de alertas frente a NEWS2. La reducción estimada ronda el 30 %,
					pero su intervalo de confianza del 95 % incluye el cero: el resultado es
					consistente con la hipótesis y no concluyente. Tampoco está el análisis de
					tendencia sobre series temporales, que depende de datos que el proyecto
					todavía no consiguió.
				</p>
				</div>

				{/* La columna derecha no es decoración: es la explicación del modelo,
				    que es justo lo que se sacó de la pantalla clínica por ocupar
				    demasiado en una ronda. Acá no estorba y es lo que distingue al
				    proyecto de una calculadora. Replica el panel real —violeta,
				    borde punteado, fuera de la escala cromática de NEWS2— con los
				    valores de un caso del seed. */}
				<aside class="predict-demo" aria-label="Ejemplo de estimación del modelo">
					<div class="predict-demo-cab">
						<strong>Estimación del modelo</strong>
						<span class="predict-pill">alerta · 99,4 %</span>
					</div>
					<p class="predict-demo-razon">
						Pesan sobre todo <strong>frecuencia respiratoria</strong> y
						<strong>confusión nueva</strong>.
					</p>
					<ul class="predict-demo-lista" role="list">
						{[
							{ p: 'Frecuencia respiratoria', v: '80', ancho: 100, acerca: true },
							{ p: 'Confusión nueva', v: '1', ancho: 62, acerca: true },
							{ p: 'Presión sistólica', v: '280', ancho: 48, acerca: false },
							{ p: 'Temperatura', v: '35', ancho: 34, acerca: false },
						].map((c) => (
							<li>
								<span>{c.p}</span>
								<span class="predict-demo-val">{c.v}</span>
								<span class={c.acerca ? 'predict-barra' : 'predict-barra hueca'} style={`width:${c.ancho}%`} aria-hidden="true"></span>
								<span class="predict-demo-dir">{c.acerca ? 'acerca' : 'aleja'}</span>
							</li>
						))}
					</ul>
					<a class="enlace" href="https://zaha-cdss-inferencia.hf.space/" target="_blank" rel="noopener">
						Probar el modelo con valores propios →
					</a>
					<p class="predict-demo-pie">
						Caso ficticio. La reducción de alertas frente a NEWS2 todavía no está
						demostrada.
					</p>
				</aside>
				</div>
			</section>

			<!-- ── Datos y créditos ─────────────────────────────────────── -->
			<section class="env" id="datos" aria-labelledby="h-datos">
				<div class="duo">
				<div class="angosta">
				<h2 id="h-datos">Datos y créditos</h2>
				<p>
					<strong>NEWS2</strong> es una escala publicada por el Royal College of
