			}

			/* ═══ Bloque de marca ═══════════════════════════════════════════
			   El padding inferior es grande a propósito: ahí se monta el
			   tablero con un margen negativo. */
			.bloque {
				background: var(--color-accent-700);
				color: var(--color-bg);
				border-radius: 0 0 var(--radius-lg) var(--radius-lg);
				padding-block: var(--space-4) calc(var(--space-8) * 4.3);
			}
			.barra {
				display: flex; align-items: center; justify-content: space-between;
				flex-wrap: wrap; gap: var(--space-3);
